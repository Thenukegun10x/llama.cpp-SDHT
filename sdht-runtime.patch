+class TQ1_0_128(__Quant, qtype=GGMLQuantizationType.TQ1_0_128):
+    @classmethod
+    def quantize_blocks(cls, blocks: np.ndarray) -> np.ndarray:
+        n_blocks = blocks.shape[0]
+
+        d = abs(blocks).max(axis=-1, keepdims=True)
+        with np.errstate(divide="ignore"):
+            id = np.where(d == 0, 0, 1 / d)
+        qs = np_roundf(blocks * id)
+        qs = (qs.astype(np.int8) + np.int8(1)).astype(np.uint8)
+
+        # 5-trit stages: 16 bytes cover 80 elements, the next 8 cover 40, qh holds the last 8
+        w5 = np.array([81, 27, 9, 3, 1], dtype=np.uint8).reshape((1, 5, 1))
+        w4 = np.array([81, 27, 9, 3], dtype=np.uint8).reshape((1, 4, 1))
+
+        qs0 = qs[..., :80].reshape((n_blocks, 5, 16)) * w5
+        qs0 = qs0.sum(axis=-2).reshape((n_blocks, 16))
+        qs1 = qs[..., 80:120].reshape((n_blocks, 5, 8)) * w5
+        qs1 = qs1.sum(axis=-2).reshape((n_blocks, 8))
+        qh = qs[..., 120:].reshape((n_blocks, 4, 2)) * w4
+        qh = qh.sum(axis=-2).reshape((n_blocks, 2))
+        qs = np.concatenate([qs0, qs1, qh], axis=-1)
+        qs = (qs.astype(np.uint16) * 256 + (243 - 1)) // 243
+
+        qs = qs.astype(np.uint8)
+        d = d.astype(np.float16).view(np.uint8)
+
+        return np.concatenate([qs, d], axis=-1)
+
+    @classmethod
+    def dequantize_blocks(cls, blocks: np.ndarray) -> np.ndarray:
+        n_blocks = blocks.shape[0]
+
+        qs, rest = np.hsplit(blocks, [24])
+        qh, d = np.hsplit(rest, [2])
+
+        d = d.view(np.float16).astype(np.float32)
+
+        w5 = np.array([1, 3, 9, 27, 81], dtype=np.uint8).reshape((1, 5, 1))
+        w4 = np.array([1, 3, 9, 27], dtype=np.uint8).reshape((1, 4, 1))
+
+        qs0 = qs[..., :16].reshape((n_blocks, 1, 16)) * w5
+        qs0 = qs0.reshape((n_blocks, 80))
+        qs1 = qs[..., 16:24].reshape((n_blocks, 1, 8)) * w5
+        qs1 = qs1.reshape((n_blocks, 40))
+        qh = qh.reshape((n_blocks, 1, 2)) * w4
+        qh = qh.reshape((n_blocks, 8))
+        qs = np.concatenate([qs0, qs1, qh], axis=-1)
+        qs = ((qs.astype(np.uint16) * 3) >> 8).astype(np.int8) - np.int8(1)
+
+        return (d * qs.astype(np.float32))
