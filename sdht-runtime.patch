+size_t quantize_tq1_0_128(const float * GGML_RESTRICT src, void * GGML_RESTRICT dst, int64_t nrow, int64_t n_per_row, const float * quant_weights) {
+    const size_t row_size = ggml_row_size(GGML_TYPE_TQ1_0_128, n_per_row);
+    const int64_t blocks_per_row = n_per_row/QK_TQ1_0_128;
+    block_tq1_0_128 * output = dst;
+    for (int64_t row = 0; row < nrow; ++row) {
+        for (int64_t block = 0; block < blocks_per_row; ++block) {
+            const int64_t column = block*QK_TQ1_0_128;
+            quantize_block_tq1_0_128_fitted(src + row*n_per_row + column,
+                    output + row*blocks_per_row + block,
+                    quant_weights ? quant_weights + column : NULL);
+        }
+    }
+    return nrow * row_size;
+}
