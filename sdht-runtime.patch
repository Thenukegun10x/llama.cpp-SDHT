+            const int e = 80 + 8*t + 4*g;
+
+            sumi[e >> 5] = ggml_cuda_dp4a(q, get_int_b4(bq8_1[iqs + (e >> 5)].qs, (e & 31) >> 2), sumi[e >> 5]);
