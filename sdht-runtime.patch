+    }
+
+#pragma unroll
+    for (int g = 0; g < 2; ++g) {
+        const uint32_t packed = (uint32_t) get_int_b4(bq->qs + 16, g);
+
+        uint32_t v_lo = packed & 0x00FF00FF;
+        uint32_t v_hi = (packed >> 8) & 0x00FF00FF;
