+static void quantize_block_tq1_0_128_fitted(
+        const float * x, block_tq1_0_128 * y, const float * importance) {
+    float magnitude[QK_TQ1_0_128];
+    float weight[QK_TQ1_0_128];
+    float best_levels[QK_TQ1_0_128];
+    float maximum = 0.0f;
+    double energy = 0.0;
+    for (int j = 0; j < QK_TQ1_0_128; ++j) {
+        magnitude[j] = fabsf(x[j]);
+        weight[j] = importance ? MAX(importance[j], 0.0f) : 1.0f;
+        maximum = MAX(maximum, magnitude[j]);
+        energy += (double) weight[j]*(double) x[j]*(double) x[j];
+    }
+    // Keep the reference encoding as a candidate, including its FP16 scale rounding.
+    float best_scale = GGML_FP16_TO_FP32(GGML_FP32_TO_FP16(maximum));
+    const float inverse = maximum ? 1.0f/maximum : 0.0f;
+    double best_loss = 0.0;
+    for (int j = 0; j < QK_TQ1_0_128; ++j) {
+        best_levels[j] = (float) lroundf(x[j]*inverse);
+        const double error = (double) x[j] - (double) best_levels[j]*(double) best_scale;
+        best_loss += (double) weight[j]*error*error;
+    }
+    const float initial[] = {0.2f, 0.35f, 0.5f, 0.65f, 0.8f};
+    for (int trial = 0; trial < 5; ++trial) {
+        float scale = maximum*initial[trial];
+        for (int iteration = 0; iteration < 13; ++iteration) {
+            const float rounded = GGML_FP16_TO_FP32(GGML_FP32_TO_FP16(scale));
+            const float threshold = 0.5f*rounded;
+            double numerator = 0.0, denominator = 0.0;
+            for (int j = 0; j < QK_TQ1_0_128; ++j) {
+                if (magnitude[j] != 0.0f && magnitude[j] >= threshold) {
+                    numerator += (double) weight[j]*(double) magnitude[j];
+                    denominator += (double) weight[j];
+                }
+            }
+            const double candidate_scale = (double) rounded;
+            const double loss = energy - 2.0*candidate_scale*numerator + candidate_scale*candidate_scale*denominator;
+            if (loss < best_loss) {
+                best_loss = loss;
+                best_scale = rounded;
+                for (int j = 0; j < QK_TQ1_0_128; ++j) {
+                    best_levels[j] = magnitude[j] != 0.0f && magnitude[j] >= threshold ? copysignf(1.0f, x[j]) : 0.0f;
+                }
+            }
+            scale = denominator ? (float) (numerator/denominator) : 0.0f;
+            if (GGML_FP32_TO_FP16(scale) == GGML_FP32_TO_FP16(rounded)) {
+                break;
+            }
+        }
+    }
+    quantize_row_tq1_0_128_ref(best_levels, y, QK_TQ1_0_128);
+    y->d = GGML_FP32_TO_FP16(best_scale);
+}
