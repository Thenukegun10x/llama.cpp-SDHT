+static __device__ __forceinline__ void dequantize_tq1_0_128(const void * vx, const int64_t ib, const int iqs, float2 & v){
+    const block_tq1_0_128 * x = (const block_tq1_0_128 *) vx;
+
+    const float d = x[ib].d;
+
+    v.x = tq1_0_128_trit(x, ib, iqs)     * d;
+    v.y = tq1_0_128_trit(x, ib, iqs + 1) * d;
+}
