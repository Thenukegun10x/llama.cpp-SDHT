+// element `e` of a ternary block_tq1_0_128 in natural order (5-element stages, then 4-element qh)
+static __device__ __forceinline__ float tq1_0_128_trit(const block_tq1_0_128 * x, const int64_t ib, const int e) {
+    static const uint8_t pow3[6] = {1, 3, 9, 27, 81, 243};
+
+    const int n_qs     = sizeof(x->qs);            // 24
+    const int n_stage0 = n_qs - n_qs % 16;         // 16
+    const int n_elem0  = n_stage0 * 5;             // 80
+    const int n_elem1  = (n_qs - n_stage0) * 5;    // 40
+    const int n_qh     = sizeof(x->qh);            // 2
+
+    uint8_t q;
+    uint8_t t;
+
+    if (e < n_elem0) {
+        t = (uint8_t) (e / n_stage0);
+        q = x[ib].qs[e % n_stage0];
+    } else if (e < n_elem0 + n_elem1) {
+        const int e2 = e - n_elem0;
+        const int w  = n_qs - n_stage0;            // 8
+        t = (uint8_t) (e2 / w);
+        q = x[ib].qs[n_stage0 + e2 % w];
+    } else {
+        const int e3 = e - n_elem0 - n_elem1;
+        t = (uint8_t) (e3 / n_qh);
+        q = x[ib].qh[e3 % n_qh];
+    }
+
+    // q * pow3[t] must wrap to 8 bits to match the reference decode
+    return (float) ((int) (((uint16_t) (uint8_t) (q * pow3[t]) * 3) >> 8) - 1);
+}
